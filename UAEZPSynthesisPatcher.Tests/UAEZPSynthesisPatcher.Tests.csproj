<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <PatcherProject>$(MSBuildThisFileDirectory)..\UAEZPSynthesisPatcher\UAEZPSynthesisPatcher.csproj</PatcherProject>
    <PatcherTargetPath>$(MSBuildThisFileDirectory)..\UAEZPSynthesisPatcher\bin\$(Configuration)\net10.0\UAEZPSynthesisPatcher.dll</PatcherTargetPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.0" />
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.54.4" />
    <PackageReference Include="Mutagen.Bethesda.Synthesis" Version="0.36.6" />
    <ProjectReference Include="$(PatcherProject)" BuildReference="false" ReferenceOutputAssembly="false" />
    <Reference Include="UAEZPSynthesisPatcher" HintPath="$(PatcherTargetPath)" Private="true" />
  </ItemGroup>

  <!--
    The patcher remains visible in the solution but is built through this reference.
    This prevents the solution and ProjectReference graphs from scheduling the same
    source-generator-heavy project concurrently on high-core-count hosts.
  -->
  <Target Name="BuildPatcherReference"
          BeforeTargets="ResolveAssemblyReferences">
    <MSBuild Projects="$(PatcherProject)"
             Targets="Build"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);Platform=AnyCPU" />
  </Target>
</Project>
